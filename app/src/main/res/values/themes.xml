<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UMMA" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/umma_primary</item>
        <item name="colorPrimaryDark">@color/umma_primary_dark</item>
        <item name="colorSecondary">@color/umma_secondary</item>
        <item name="colorError">@color/umma_error</item>
        <item name="android:statusBarColor">@color/umma_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>

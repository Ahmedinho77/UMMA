<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/umma_primary"
            app:title="UMMA University Portal"
            app:titleTextColor="@color/text_on_dark" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_header_gradient">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserAvatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_placeholder"
                        app:tint="@color/surface_light"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        android:background="#33FFFFFF"
                        android:padding="8dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome back,"
                            android:textSize="13sp"
                            android:textColor="#D0E8D0" />

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User Name"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_on_dark"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/tvSubDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reg No"
                            android:textSize="12sp"
                            android:textColor="#D0E8D0"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROLE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_dark"
                        android:background="@drawable/bg_chip_paid"
                        android:backgroundTint="#40FFFFFF"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dashboard Stats Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Stat 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStat1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_light">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStat1Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/umma_primary" />
                        <TextView
                            android:id="@+id/tvStat1Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Courses"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStat2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_light">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStat2Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3.8"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/umma_accent" />
                        <TextView
                            android:id="@+id/tvStat2Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GPA"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStat3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_light">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStat3Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 0"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/umma_warning"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/tvStat3Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fee Balance"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Announcement Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLatestNews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_light"
                android:layout_marginBottom="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_news"
                            app:tint="@color/umma_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Latest Announcement"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/umma_secondary"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/tvNewsDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNewsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Welcome to Semester"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvNewsSnippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Check timetables and fee details."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvReadAllNews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Read All News →"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/umma_primary"
                        android:layout_gravity="end"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Grid -->
            <TextView
                android:id="@+id/tvQuickActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="University Services"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <GridLayout
                android:id="@+id/gridActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- Action Button 1 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:text="Courses &amp; Units"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_courses"
                    app:iconGravity="top"
                    app:iconSize="22dp"
                    app:cornerRadius="14dp" />

                <!-- Action Button 2 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction2"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:text="Timetable &amp; Exams"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_results"
                    app:iconGravity="top"
                    app:iconSize="22dp"
                    app:cornerRadius="14dp" />

                <!-- Action Button 3 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction3"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:text="Assignments"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_notes"
                    app:iconGravity="top"
                    app:iconSize="22dp"
                    app:cornerRadius="14dp" />

                <!-- Action Button 4 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction4"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:text="Results &amp; Transcript"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_marks"
                    app:iconGravity="top"
                    app:iconSize="22dp"
                    app:cornerRadius="14dp" />

                <!-- Action Button 5 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction5"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:text="Fee Statement"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_fees"
                    app:iconGravity="top"
                    app:iconSize="22dp"
                    app:cornerRadius="14dp" />

                <!-- Action Button 6 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction6"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:text="Library Books"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_courses"
                    app:iconGravity="top"
                    app:iconSize="22dp"
                    app:cornerRadius="14dp" />

                <!-- Action Button 7 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction7"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:text="Campus Services"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_students"
                    app:iconGravity="top"
                    app:iconSize="22dp"
                    app:cornerRadius="14dp" />

                <!-- Action Button 8 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction8"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:text="Helpdesk &amp; Support"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="top"
                    app:iconSize="22dp"
                    app:cornerRadius="14dp" />

            </GridLayout>

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Logout"
                android:textSize="15sp"
                android:textColor="@color/umma_error"
                app:strokeColor="@color/umma_error"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
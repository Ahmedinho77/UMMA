<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAssignmentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Assignment Submission"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAttachFile"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="📎 Attach PDF / Document File"
        android:textColor="@color/umma_primary"
        app:strokeColor="@color/umma_primary"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvAttachedFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Attached: Solution_Doc_v1.pdf"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/umma_success"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Submission Notes / Comments">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSubmissionNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:minLines="2"
            android:gravity="top"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>